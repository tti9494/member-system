name = "arsen-member-system"
main = "src/worker.js"
compatibility_date = "2026-05-20"
workers_dev = true
# Production route is attached by scripts/deploy-cloudflare.mjs:
# apply.arsen-ai.com/*

[assets]
directory = "./dist"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "arsen_member_system"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGINS = "https://arsen-ai.com,https://www.arsen-ai.com,https://apply.arsen-ai.com"

# Required Cloudflare secrets before production deploy:
# - ADMIN_API_KEY
# - PHONE_SECRET_KEY
# - EMAIL_SECRET_KEY
# - CONTACT_ENCRYPTION_KEY
# - LICENSE_SECRET_KEY

# Optional Kakao notice AI polish (발송 전 승인 단계 문구 다듬기).
# 미설정 시 polish_status=unavailable 로 원문 그대로 발송되며 기존 흐름은 유지된다.
# Secrets (wrangler secret put):
# - ANTHROPIC_API_KEY  (우선순위 1)
# - GEMINI_API_KEY     (우선순위 2)
# Optional [vars]:
# - KAKAO_POLISH_PROVIDER = "anthropic" | "gemini"  (기본: 키가 있는 첫 프로바이더)
# - KAKAO_POLISH_MODEL    = 모델 ID 재정의 (기본: claude-opus-4-8 / gemini-2.5-flash)
# - KAKAO_POLISH_ENABLED  = "0" 으로 다듬기 비활성화 (skipped 처리)
